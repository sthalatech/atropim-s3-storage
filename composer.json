{
    "name": "sthalatech/atropim-s3-storage",
    "description": "S3-compatible object storage backend for AtroPIM/AtroCore file/media storage.",
    "type": "library",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/sthalatech/atropim-s3-storage",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4",
        "atrocore/core": ">=2.3.4",
        "async-aws/s3": "^3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/atrocore/atrocore"
        }
    ],
    "autoload": {
        "psr-4": {
            "S3Storage\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "S3Storage\\Tests\\": "tests/"
        }
    },
    "extra": {
        "atroId": "S3Storage",
        "name": {
            "default": "S3 Storage"
        },
        "description": {
            "default": "Store and serve file/media assets in AWS S3 or S3-compatible object storage instead of local disk."
        }
    }
}
